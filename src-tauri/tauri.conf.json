{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlobalMusic",
  "version": "../package.json",
  "identifier": "com.globalmusic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Spotify, YouTube Music e SoundCloud em um só player leve.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libasound2", "libssl3"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0MDhFRDNBOUY3QTNEMzgKUldRNFBYcWZPdTBJSkZRV3RyUmE3cnFTakJpM0NMeXIvanRyTHZValNwS0tRTWZjUE1ta0xqK3QK",
      "endpoints": ["https://globalmusic.216saint.com.br/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
