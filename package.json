{
  "name": "globalmusic",
  "private": true,
  "version": "0.6.1",
  "description": "Player de música global e leve: Spotify, YouTube Music e SoundCloud em um só lugar.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "node scripts/with-cargo.mjs tauri",
    "app:dev": "node scripts/with-cargo.mjs tauri dev",
    "app:build": "node scripts/with-cargo.mjs tauri build --config src-tauri/tauri.sidecar.conf.json && npm run copy:installers",
    "app:build:win": "node scripts/with-cargo.mjs tauri build --bundles nsis --config src-tauri/tauri.sidecar.conf.json && npm run copy:installers",
    "copy:installers": "node scripts/with-cargo.mjs node scripts/copy-installers.mjs",
    "release": "node scripts/release.mjs",
    "test:rust": "node scripts/with-cargo.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "setup:yt-dlp": "node scripts/fetch-yt-dlp.mjs",
    "measure:ram": "node scripts/measure-ram.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
